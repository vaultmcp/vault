[19.23, "o", "  Summary\r\n"]
[19.32, "o", "\r\n"]
[19.41, "o", "  Vault detected 4 malicious \u00b7 3 suspicious \u00b7 1 clean in 8 scans\r\n"]
[19.5, "o", "\r\n"]
