# rh-trade configuration — copy to `.env` and fill in. NEVER commit a filled-in copy.
# `.env` and `.env.*` are gitignored. In production, inject these from a secret manager
# (AWS Secrets Manager / ECS task secrets / Doppler / GitHub Actions secrets), not a file.

# --- Chain (Robinhood Chain mainnet is 4663) ---
RH_CHAIN_RPC_URL=        # e.g. an RH mainnet RPC (Alchemy/QuickNode/public)
RH_CHAIN_ID=4663
RH_USDG_ADDRESS=0x5fc5360D0400a0Fd4f2af552ADD042D716F1d168   # USDG (mainnet, from RH docs)

# --- Tokenized equities to trade (one per symbol; confirm the address on the explorer) ---
# The official tokens are labeled "• Robinhood Token" — beware lookalikes.
RH_TOKEN_TAAPL=          # e.g. 0xaF3D76f1834A1d425780943C99Ea8A608f8a93f9 (Apple • Robinhood Token)

# --- Uniswap Trading API (swaps route through this — get a FREE key) ---
# https://developers.uniswap.org/dashboard
UNISWAP_API_KEY=
# Optional base-URL override (defaults to the public gateway):
# UNISWAP_TRADING_API_URL=https://trade-api.gateway.uniswap.org/v1

# The wallet used as the swap origin for quotes (public address only — NOT the key):
RH_WALLET_ADDRESS=

# --- LIVE mode (broadcasts a real transaction) — leave OFF for dry-run ---
RH_LIVE=0
# PRIVATE_KEY: ONLY set at runtime for a live swap, ONLY on your machine / a secret
# store. Never write it into a committed file. A funded RH-mainnet wallet with a little
# USDG + gas. Rotate/retire it after testing.
# PRIVATE_KEY=
